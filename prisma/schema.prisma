// Cloud POS — Prisma schema
// Multi-tenant: every table hangs off Business, scoped by businessId.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  OWNER
  MANAGER
  CASHIER
}
enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}
model Business {
  id         String   @id @default(cuid())
  slug       String   @unique // short public id used in the shop share link, e.g. ?shop=slug
  name       String
  ownerName  String?
  email      String?
  phone      String?
  address    String?
  logoUrl    String?
  supportPhone String? // shown on the public storefront so customers can reach the store directly
  currency   String   @default("GHS")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  users      User[]
  products   Product[]
  sales      Sale[]
  customers  Customer[]
  orders     Order[]
}
model User {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id])
  businessId   String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  sales        Sale[]
  @@index([businessId])
}
model Product {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  name        String
  category    String?
  price       Decimal  @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  stock       Int      @default(0)
  sku         String?
  image       String?
  inShop      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  saleItems   SaleItem[]
  orderItems  OrderItem[]
  @@index([businessId])
}
model Sale {
  id            String   @id @default(cuid())
  business      Business @relation(fields: [businessId], references: [id])
  businessId    String
  cashier       User?    @relation(fields: [cashierId], references: [id])
  cashierId     String?
  total         Decimal  @db.Decimal(12, 2)
  paymentMethod String?
  clientTxnId   String   @unique // used for receipt QR verification
  createdAt     DateTime @default(now())
  items         SaleItem[]
  @@index([businessId])
}
model SaleItem {
  id         String  @id @default(cuid())
  sale       Sale    @relation(fields: [saleId], references: [id])
  saleId     String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
}
model Customer {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id])
  businessId   String
  fullName     String
  email        String
  phone        String?
  address      String? // last-used delivery address, auto-filled on future orders
  latitude     Float?  // GPS coordinates captured via "Use my location" at checkout
  longitude    Float?
  passwordHash String
  createdAt    DateTime @default(now())
  orders       Order[]
  @@unique([businessId, email])
}
model Order {
  id           String      @id @default(cuid())
  business     Business    @relation(fields: [businessId], references: [id])
  businessId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  customerId   String
  status       OrderStatus @default(PENDING)
  total        Decimal     @db.Decimal(12, 2)
  fulfillment  String?
  createdAt    DateTime    @default(now())
  items        OrderItem[]
  @@index([businessId])
}
model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
}
